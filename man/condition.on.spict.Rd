  res <- condition.on.spict(dat, set, fit, nrep = set$nrep)
  set$noise$time$F <- c(0, 0, 1)   ## F is already conditioned
  set$errs <- res$errs
  mse <- run.mse(dat, set, fest = res$FM)
  }
